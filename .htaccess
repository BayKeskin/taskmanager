Options -MultiViews -Indexes
DirectoryIndex index.php View/index/board.php

<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteBase /taskmanager/

    # HTTP Authorization Header'ı PHP'ye aktar (Bearer Token desteği)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Statik dosyalara (CSS, JS, Resimler, Fontlar) doğrudan erişim izni
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # TaskManager Sayfa Rotaları (HMVC Modülleri & Bootstrap)
    RewriteRule ^$                      index.php [L,NC,QSA]
    RewriteRule ^login/?$               index.php?page=login [L,NC,QSA]
    RewriteRule ^logout/?$              index.php?page=logout [L,NC,QSA]
    RewriteRule ^tasks/?$               index.php?page=board [L,NC,QSA]
    RewriteRule ^board/?$               index.php?page=board [L,NC,QSA]
    RewriteRule ^kanban/export-excel/?$ Controller/ajax/ajax.php?action=export_excel [L,NC,QSA]
    RewriteRule ^calendar/?$            index.php?page=calendar [L,NC,QSA]
    RewriteRule ^reports/?$             index.php?page=reports [L,NC,QSA]
    RewriteRule ^billing-report/?$      index.php?page=billing-report [L,NC,QSA]
    RewriteRule ^team/?$                index.php?page=team [L,NC,QSA]
    RewriteRule ^docs/?$                index.php?page=docs [L,NC,QSA]
    RewriteRule ^chat/?$                index.php?page=chat [L,NC,QSA]
    RewriteRule ^settings/?$            index.php?page=settings [L,NC,QSA]
    RewriteRule ^ajax/?$                Controller/ajax/ajax.php [L,NC,QSA]
    RewriteRule ^ajax/(.*)$             Controller/ajax/ajax.php?action=$1 [L,NC,QSA]
    RewriteRule ^events/?$              Controller/sse.php [L,NC,QSA]
    RewriteRule ^api/sse/?$             Controller/sse.php [L,NC,QSA]

    RewriteRule ^api/?$                 Modules/RestApi/Controllers/index.php [L,NC,QSA]
    RewriteRule ^api/(.*)$              Modules/RestApi/Controllers/index.php?path=$1 [L,NC,QSA]
    RewriteRule ^api[-_]docs/?$         index.php?page=api-docs [L,NC,QSA]
    RewriteRule ^api[-_]test/?$         index.php?page=api-test [L,NC,QSA]
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
</IfModule>

